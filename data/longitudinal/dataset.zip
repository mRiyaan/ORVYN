  <dialog id="railsConfirmDialog" class="modalDialog" role="alertdialog" aria-labelledby="railsConfMsg" aria-modal="true">
  <div>
    <button id="railsConfirmDialogClose" class="button-close-modal" style="float: right;" aria-label="close" type="button"><i class="fas fa-close" aria-hidden="true"></i></button>
    <h1 id="railsConfMsg" class="o-heading__level2" style="width: 30ch; max-width: 100%; float: left;"></h1>    
    <div style="clear: both;">&nbsp;</div>
    <div style="display: flex; justify-content: flex-end; column-gap: 1rem;">
      <button id="railsConfirmDialogYes" class="o-button__plain-text2" style="padding: .5rem 2rem;" value="default">Yes</button>
      <button id="railsConfirmDialogNo" class="o-button__plain-text3" style="padding: .5rem 2rem;" value="cancel">No</button>
    </div>
  </div>
</dialog>

<script>
  // adds the polyfill for firefox and some other browsers that are not up to date.
  // https://github.com/GoogleChrome/dialog-polyfill

  const modal = document.getElementById('railsConfirmDialog');
  dialogPolyfill.registerDialog(modal);
</script>
  <dialog id="genericModalDialog" class="modalDialog" aria-modal="true" aria-labelledby="dialog-title">
  <div>
    <div class="modalClose">
      <button id="genericModalClose" aria-label="Close dialog" type="button">
        <i class="fas fa-close" aria-hidden="true"></i>
      </button>
    </div>
    <!-- to display anything in the dialog, replace content within the genericModalContent (using Javascript) and attach any events
      you need for what you add. The dialog comes with an event for closing and taking no action for the close button.

      Open modal with <item>.showModal(); and close with <item>.close();
      -->
    <div id="genericModalContent" class="c-modal-content__normal">&nbsp;</div>
  </div>
</dialog>

<script>
  // adds the polyfill for firefox and some other browsers that are not up to date.
  // https://github.com/GoogleChrome/dialog-polyfill

  const modal2 = document.getElementById('genericModalDialog');
  dialogPolyfill.registerDialog(modal2);

  $('#genericModalClose').click(function(){
    document.querySelector('#genericModalContent').classList.replace('c-modal-content__wide', 'c-modal-content__normal');
    document.querySelector('#genericModalContent').classList.replace('c-modal-content__cedar','c-modal-content__normal');
    $('#genericModalDialog')[0].close(); // uses [0] to get native object rather than jQuery object (I think)
    $('#genericModalContent').html("");
  });
</script>

  
